{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "E-commerce product catalog item",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 255 },
        "slug": { "type": "string", "maxLength": 255 },
        "sku": { "type": "string", "maxLength": 64 },
        "category": { "type": "string", "maxLength": 100 },
        "brand": { "type": "string", "maxLength": 100 },
        "price": { "type": "number" },
        "salePrice": { "type": "number" },
        "stock": { "type": "number" },
        "images": { "type": "array" },
        "description": { "type": "string", "maxLength": 5000 },
        "shortDescription": { "type": "string", "maxLength": 1000 },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "featured": { "type": "boolean" },
        "bestSeller": { "type": "boolean" },
        "newArrival": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "category", "price", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order record",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "orderNumber": { "type": "string", "maxLength": 64 },
        "customerId": { "type": "string", "maxLength": 128 },
        "customerName": { "type": "string", "maxLength": 200 },
        "customerPhone": { "type": "string", "maxLength": 30 },
        "customerWhatsApp": { "type": "string", "maxLength": 30 },
        "customerEmail": { "type": "string", "maxLength": 200 },
        "city": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 500 },
        "orderNotes": { "type": "string", "maxLength": 1000 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shipping": { "type": "number" },
        "discount": { "type": "number" },
        "total": { "type": "number" },
        "couponCode": { "type": "string", "maxLength": 50 },
        "paymentMethod": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "maxLength": 50 },
        "trackingNumber": { "type": "string", "maxLength": 100 },
        "adminNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "orderNumber", "customerName", "customerPhone", "city", "address", "total", "status", "paymentMethod"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and shipping defaults",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 200 },
        "displayName": { "type": "string", "maxLength": 200 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "phone": { "type": "string", "maxLength": 30 },
        "whatsapp": { "type": "string", "maxLength": 30 },
        "city": { "type": "string", "maxLength": 100 },
        "address": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "maxLength": 30 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Global store settings and config",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "storeName": { "type": "string", "maxLength": 200 },
        "whatsappNumber": { "type": "string", "maxLength": 30 },
        "phoneNumber": { "type": "string", "maxLength": 30 },
        "supportEmail": { "type": "string", "maxLength": 200 },
        "easypaisaNumber": { "type": "string", "maxLength": 30 },
        "easypaisaAccountName": { "type": "string", "maxLength": 100 },
        "jazzcashNumber": { "type": "string", "maxLength": 30 },
        "jazzcashAccountName": { "type": "string", "maxLength": 100 },
        "freeShippingThreshold": { "type": "number" },
        "standardShippingFee": { "type": "number" },
        "announcementText": { "type": "string", "maxLength": 500 },
        "bannerActive": { "type": "boolean" },
        "deliveryTimeEstimate": { "type": "string", "maxLength": 100 }
      },
      "required": ["id", "storeName", "whatsappNumber"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon code",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "code": { "type": "string", "maxLength": 50 },
        "discountType": { "type": "string", "maxLength": 20 },
        "discountValue": { "type": "number" },
        "minOrderAmount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 200 }
      },
      "required": ["id", "code", "discountType", "discountValue", "isActive"]
    },
    "Category": {
      "title": "Category",
      "description": "Store category definition",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "name": { "type": "string", "maxLength": 100 },
        "slug": { "type": "string", "maxLength": 100 },
        "icon": { "type": "string", "maxLength": 50 },
        "image": { "type": "string", "maxLength": 1000 },
        "description": { "type": "string", "maxLength": 1000 },
        "isFeatured": { "type": "boolean" },
        "displayOrder": { "type": "number" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "image"]
    },
    "Review": {
      "title": "Review",
      "description": "Product review submitted by customer",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "productId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 200 },
        "rating": { "type": "number" },
        "comment": { "type": "string", "maxLength": 2000 },
        "verifiedPurchase": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "productId", "userName", "rating", "comment"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": "Product",
      "description": "Catalog of mobile & electronics accessories"
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Store checkout orders"
    },
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profiles and settings"
    },
    "/settings/{settingId}": {
      "schema": "Setting",
      "description": "Store configurations"
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount vouchers"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Store product categories"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews"
    }
  }
}
