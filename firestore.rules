rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'nasiryaseen2011@gmail.com' ||
        request.auth.token.email == 'muhammadali7394@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Connectivity Test
    match /test/{testId} {
      allow read: if true;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Products catalog (Public read, Admin write)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin() || true; // allow store management in dev preview
    }

    // Orders (Create by anyone for checkout, Read by owner or admin, Update by admin)
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if true;
    }

    // User profiles (Owner read/write, Admin read/write)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Store Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if true;
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow create, update, delete: if true;
    }

    // Coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if true;
    }

    // Reviews
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
